# EcoGrid-Twin — Environment Configuration (Tamil Nadu Edition)

# Application Settings
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Site & Geography
SITE_NAME="Chennai Industrial Microgrid"
TAMILNADU_CITY="Chennai"
LATITUDE=13.0827
LONGITUDE=80.2707
TIMEZONE="Asia/Kolkata"

# TNPDCL Consumer Category & Tariffs (All in ₹ INR)
TNPDCL_CATEGORY="LT-III-B Commercial"
GRID_STANDARD_PRICE=7.50
GRID_PEAK_PRICE=9.50
GRID_OFFPEAK_PRICE=5.80
GRID_FEED_IN_TARIFF=3.50
GRID_FIXED_CHARGE=120.00
GRID_DEMAND_CHARGE=0.00
GRID_CARBON_INTENSITY=0.72 # kg CO2 / kWh for Indian Grid CEA baseline

# Hardware & Telemetry Source Mode: SIMULATION | MODBUS_RTU | MODBUS_TCP | MQTT
TELEMETRY_SOURCE="SIMULATION"

# RS485 Modbus RTU / TCP Settings (Read-Only)
MODBUS_TYPE="RTU" # RTU or TCP
MODBUS_PORT="COM3" # Windows COM port or /dev/ttyUSB0
MODBUS_BAUDRATE=9600
MODBUS_PARITY="N"
MODBUS_STOPBITS=1
MODBUS_BYTESIZE=8
MODBUS_SLAVE_ID=1
MODBUS_TCP_HOST="192.168.1.100"
MODBUS_TCP_PORT=502

# MQTT Settings (Read-Only Subscriber)
MQTT_BROKER="127.0.0.1"
MQTT_PORT=1883
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_TOPIC_METER="ecogrid/meter/telemetry"
MQTT_TOPIC_INVERTER="ecogrid/solar/inverter"
MQTT_TOPIC_BMS="ecogrid/battery/bms"

# Storage
DATABASE_URL="sqlite:///./backend/ecogrid.db"
